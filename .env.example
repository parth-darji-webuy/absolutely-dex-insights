# Copy this file to .env and fill in every value. .env is never committed.

# Store database (Neon), read-only role insights_reader. Pooled URL for the app, direct URL for Prisma.
STORE_DATABASE_URL=
STORE_DATABASE_URL_UNPOOLED=

# Sign-in. SESSION_SECRET: 32+ random characters. ADMIN_PASSWORD: 12+ characters.
SESSION_SECRET=
ADMIN_PASSWORD=

# GrowthBook (read-only). API host: https://cdn.growthbook.io for GrowthBook Cloud.
# Client key: Settings > SDK Connections, the "sdk-..." key. No secret or admin key is used.
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=

# AI answers: groq or none. GROQ_API_KEY and GROQ_MODEL are needed only for groq.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=

# Reports and charts: a time zone such as Europe/London, the first day of tracking (YYYY-MM-DD),
# and how often the store card refreshes (5 to 120 minutes).
INSIGHTS_TIMEZONE=
TRACKING_START=
STORE_REFRESH_MINUTES=
